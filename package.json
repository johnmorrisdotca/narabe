{
  "name": "@johnmorrisdotca/narabe",
  "version": "1.2.2",
  "description": "One rules engine for forty-eight abstract board games: gomoku and renju, Connect Four, tic-tac-toe, Reversi, Hex, Go, Halma, Chinese Checkers, checkers and five draughts rule sets. Pure TypeScript, every move a new state, no dependencies.",
  "keywords": [
    "abstract-board-games",
    "abstract-strategy",
    "baduk",
    "board-game",
    "board-game-engine",
    "board-game-rules",
    "board-svg",
    "browser",
    "bun",
    "checkers",
    "checkers-engine",
    "chinese-checkers",
    "cli",
    "command-line",
    "connect-4",
    "connect-five",
    "connect-four",
    "deno",
    "draughts",
    "draughts-engine",
    "english",
    "esm",
    "five-in-a-row",
    "functional",
    "game-ai-ready",
    "game-engine",
    "game-rules",
    "go",
    "go-game",
    "gobang",
    "gomoku",
    "gomoku-narabe",
    "halma",
    "hex",
    "hex-game",
    "i18n",
    "immutable",
    "japanese",
    "legal-moves",
    "move-generation",
    "move-list",
    "naraberu",
    "nine-men",
    "no-dependencies",
    "node",
    "othello",
    "pure-functions",
    "random-play",
    "react",
    "record-replay",
    "renju",
    "replayable",
    "reversi",
    "reversi-engine",
    "rules-engine",
    "seeded-random",
    "simulator",
    "svg-board",
    "tic-tac-toe",
    "tictactoe",
    "turn-based",
    "two-player-games",
    "typescript",
    "web-games",
    "weiqi",
    "zero-dependencies"
  ],
  "homepage": "https://johnmorrisdotca.github.io/narabe/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/narabe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/narabe.git"
  },
  "license": "MIT",
  "author": "John Morris",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./draw": {
      "types": "./dist/draw.d.ts",
      "import": "./dist/draw.js",
      "default": "./dist/draw.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "prepublishOnly": "pnpm check && pnpm build",
    "test:demo": "pnpm site && playwright test",
    "test:cli": "pnpm build && node scripts/check-cli.mjs",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "docs:make": "node scripts/docs.mjs",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "bin": {
    "narabe": "bin/narabe.mjs"
  }
}
